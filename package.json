{
  "name": "playdate-pixel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run electron:dev",
    "vite:dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "build:companion": "make -C companion/playdate-preview",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "concurrently -k \"npm:vite:dev\" \"npm:electron:dev:app\"",
    "electron:dev:app": "wait-on http://127.0.0.1:5173 && npm run build:electron && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "electron:start": "npm run build && electron .",
    "electron:pack": "npm run build:companion && npm run build && electron-builder --mac --dir",
    "electron:dist": "npm run build:companion && npm run build && electron-builder --mac",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit"
  },
  "build": {
    "appId": "com.playdatepixelstudio.app",
    "productName": "Playdate Pixel Studio",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "companion/playdate-preview/playdate-pixel-preview.pdx",
        "to": "playdate-pixel-preview.pdx"
      }
    ],
    "asarUnpack": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "lucide-static": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  }
}
